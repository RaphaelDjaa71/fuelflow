# --- GCP (compte existant) ---
GCP_PROJECT_ID=your-existing-gcp-project-id
GCP_REGION=europe-west1
GCS_BRONZE_BUCKET=fuelflow-bronze-<suffix>
GOOGLE_APPLICATION_CREDENTIALS=./.secrets/gcp-sa.json

# --- BigQuery (démo live durable) ---
BQ_DATASET_SILVER=fuelflow_silver
BQ_DATASET_GOLD=fuelflow_gold

# --- Snowflake (warehouse principal, région GCP, XS + auto-suspend) ---
SNOWFLAKE_ACCOUNT=xxxxx.gcp-europe-west4
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=FUELFLOW_WH
SNOWFLAKE_DATABASE=FUELFLOW
SNOWFLAKE_SCHEMA=PUBLIC

# --- Source open data ---
ROULEZ_ECO_INSTANT_URL=https://donnees.roulez-eco.fr/opendata/instantane
ROULEZ_ECO_DAILY_URL=https://donnees.roulez-eco.fr/opendata/jour
