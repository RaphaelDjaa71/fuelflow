flowchart TD
    SRC["Source open data<br/>donnees.roulez-eco.fr<br/>XML-ZIP, MAJ ~10 min"]:::source
    ING["Cloud Run Job (Python)<br/>déclenché par Cloud Scheduler<br/>micro-batch HORAIRE<br/>idempotent (if_generation_match=0)"]:::compute
    GCS["GCS bronze (EU)<br/>XML brut + Parquet typé<br/>partitionné dt=…/hh=…"]:::storage
    SF["Snowflake (AWS eu-west-3, trial)<br/>warehouse PRINCIPAL<br/>XS + auto-suspend 60s<br/>auth key-pair JWT"]:::wh
    BQ["BigQuery silver/gold (EU)<br/>démo LIVE durable<br/>free tier"]:::wh
    DBT["dbt Core<br/>staging → intermediate → gold<br/>contracts enforced (fact + dims)<br/>targets: snowflake | bigquery"]:::transform
    AGG["3 marts d'agrégation<br/>région × carburant, dernier prix,<br/>classement par région"]:::transform
    CI["GitHub Actions<br/>dbt build BLOQUANT (target bigquery)<br/>WIF keyless<br/>gate prouvé sur PR cassée"]:::cicd
    PAGES["dbt docs<br/>GitHub Pages<br/>(lineage public)"]:::cicd
    PBI["Power BI (case study)<br/>← Snowflake"]:::bi
    LS["Looker Studio (public)<br/>← BigQuery"]:::bi

    SRC --> ING --> GCS
    GCS --> SF
    GCS --> BQ
    SF --> DBT
    BQ --> DBT
    DBT --> AGG
    CI -. bloque le merge si un test échoue .-> DBT
    DBT --> PAGES
    AGG --> LS
    AGG --> PBI

